# Секретный путь, а не сам пароль
MIX_NAVIDROME_SECRET_FILE=/etc/music-stack/secrets/navidrome_admin
MIX_GATEWAY_TOKEN_FILE=/etc/music-stack/secrets/gateway_token

MIX_STATE_DIR=/var/lib/music-stack/mixcore
MIX_NAVIDROME_URL=http://127.0.0.1:4533
MIX_NAVIDROME_USER=mix-admin

# Режим генерации: algo | hybrid | ai
MIX_SYNTH_MODE=algo
MIX_MODE=offline_first
MIX_MIX_LENGTH=30
MIX_NO_REPEAT_DAYS=14
MIX_LOG_LEVEL=INFO
MIX_VERSION=0.1.0

# Погода: none | open-meteo
MIX_WEATHER_PROVIDER=none
MIX_WEATHER_API_KEY=

# Локальный ИИ (после установки Ollama переключите на hybrid и включите)
MIX_LLM_ENABLED=false
MIX_LLM_URL=http://127.0.0.1:11434
MIX_LLM_MODEL=qwen2.5:7b-instruct
MIX_LLM_MAX_INFLUENCE=0.2
MIX_AI_TIMEOUT_MS=10000
MIX_EMBEDDINGS_ENABLED=false

MIX_PROXY_NATIVE_API=false