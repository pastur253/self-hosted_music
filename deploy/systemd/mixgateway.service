[Unit]
Description=MusicStack MixGateway (Subsonic BFF перед Navidrome)
After=network-online.target music-navidrome.service mixcore.service
Wants=network-online.target
Requires=mixcore.service

[Service]
Type=exec
User=music
Group=music
WorkingDirectory=/opt/music-stack
EnvironmentFile=/etc/music-stack/mixcore.env
ExecStart=/opt/music-stack/venv/bin/uvicorn mixgateway.asgi:app --host 127.0.0.1 --port 8081 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30

StateDirectory=music-stack
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target